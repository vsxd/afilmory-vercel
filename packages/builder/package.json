{
  "name": "@afilmory/builder",
  "type": "module",
  "version": "0.1.3",
  "private": true,
  "description": "Build-time photo processing engine: scans S3-compatible or local storage, extracts EXIF, generates thumbnails and thumbhash placeholders, and emits the static photos manifest for the web app",
  "license": "SEE LICENSE IN ../../LICENSE",
  "exports": {
    ".": "./src/index.ts",
    "./thumbnail-encoding": "./src/image/encoding-signature.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "pnpm --dir ../.. exec vitest run --project builder",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@afilmory/media": "workspace:*",
    "@afilmory/schema": "workspace:*",
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/s3-request-presigner": "3.1045.0",
    "@smithy/node-http-handler": "4.6.1",
    "@vingle/bmp-js": "^0.2.5",
    "c12": "^3.3.1",
    "consola": "3.4.2",
    "dotenv-expand": "catalog:",
    "es-toolkit": "1.41.0",
    "exiftool-vendored": "catalog:",
    "heic-convert": "2.1.0",
    "sharp": "0.35.3",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
