# ========================================
# Afilmory static site config
# ========================================
#
# This file contains the environment variables a static deployment needs.
# Copy it to .env and fill in the real values.
# For Vercel, the Deploy Button only asks for storage connection settings;
# site branding and other optional settings can be added after the first deploy.
#
# S3 is the deployment default. For a zero-credential local/static build set
# PHOTO_STORAGE_PROVIDER=local and place originals under LOCAL_PHOTOS_PATH.

PHOTO_STORAGE_PROVIDER=s3
# LOCAL_PHOTOS_PATH=photos
# Root-relative, portable ASCII path segments only; application namespaces such
# as /photos and /assets are reserved.
# LOCAL_PHOTOS_BASE_URL=/originals

# ----------------------------------------
# S3 storage config (bucket required)
# ----------------------------------------

# S3 bucket name (required)
S3_BUCKET_NAME=your-bucket-name

# S3 region (optional, defaults to us-east-1)
S3_REGION=us-east-1

# Explicit credentials are optional. Omit both values to use the AWS SDK
# default credential chain (profile/SSO, web identity, ECS/EC2 role, etc.).
# If one is set, the other must be set too.
S3_ACCESS_KEY_ID=

S3_SECRET_ACCESS_KEY=

# S3 endpoint (optional, defaults to AWS S3)
# Set this when using another S3-compatible service (MinIO, Alibaba Cloud OSS, etc.).
# Examples:
# - AWS S3: https://s3.us-east-1.amazonaws.com
# - MinIO: https://minio.example.com
# - Alibaba Cloud OSS: https://oss-cn-hangzhou.aliyuncs.com
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# S3 prefix (optional, the path prefix of photos inside the bucket)
# Example: photos/ means every photo lives under the photos/ directory
S3_PREFIX=

# Custom domain (optional, when using a CDN)
# When a CDN is configured, photos are served through this domain.
# Example: https://cdn.example.com
S3_CUSTOM_DOMAIN=

# Exclude rule (optional, a regular expression that excludes certain files)
# Example: .*\.txt$ excludes all .txt files
S3_EXCLUDE_REGEX=

# ----------------------------------------
# Site config (recommended via environment variables)
# ----------------------------------------
# The following options override the defaults in site.config.ts.
# Priority: environment variables > site.config.ts defaults

# Site name (recommended)
SITE_NAME="My Photo Gallery"

# Site title (recommended)
SITE_TITLE="My Photo Gallery"

# Site description (recommended)
SITE_DESCRIPTION="Capturing beautiful moments in life"

# Site URL override (optional on Vercel). With VERCEL=1, builds automatically
# use https://VERCEL_PROJECT_PRODUCTION_URL, including during preview builds.
# Elsewhere the default comes from site.config.ts. Set this explicitly when
# using another static host or choosing a different canonical domain.
# SITE_URL=https://your-site.vercel.app

# Accent color (optional, defaults to #007bff)
SITE_ACCENT_COLOR="#007bff"

# Site language (optional, defaults to en; at runtime the page language prefers browser detection)
SITE_LANGUAGE=en

# ----------------------------------------
# Author info (recommended)
# ----------------------------------------

# Author name
AUTHOR_NAME="Your Name"

# Author website
AUTHOR_URL=https://your-website.com

# Author avatar URL
AUTHOR_AVATAR=https://your-avatar-url.com/avatar.png

# ----------------------------------------
# Social media (optional)
# ----------------------------------------

# GitHub username
SOCIAL_GITHUB=your-github-username

# Twitter username
SOCIAL_TWITTER=your-twitter-username

# Enable RSS (true or false)
SOCIAL_RSS=false

# ----------------------------------------
# Feed config (optional)
# ----------------------------------------
# Set the following when using a service like Folo.

# Folo Feed ID
FEED_FOLO_FEED_ID=

# Folo User ID
FEED_FOLO_USER_ID=

# ----------------------------------------
# Map config (optional)
# ----------------------------------------

# Map style (builtin or custom)
MAP_STYLE=builtin

# Map projection (globe or mercator)
MAP_PROJECTION=mercator

# ----------------------------------------
# Frontend debug switches (optional)
# ----------------------------------------
# Regular local development does not print internal debug chatter by default;
# turn these on when troubleshooting runtime/cache/image/map.
VITE_AFILMORY_DEBUG=false
VITE_AFILMORY_WEBGL_DEBUG=false
# Opt in to Vercel's browser performance beacon.
VITE_ENABLE_SPEED_INSIGHTS=false

# ----------------------------------------
# Corresponding source metadata (deployment safety)
# ----------------------------------------
# Fork repository base URL override. GitHub/Vercel metadata and the local
# credential-free origin remote are detected automatically when this is unset.
# AFILMORY_SOURCE_URL=https://github.com/your-name/your-gallery

# CI/Vercel refuses to publish Project Code that differs from the advertised
# Git revision. For an intentional dirty-source deployment, point this at a
# public archive or tree containing the exact deployed source (no secret query
# tokens: this URL is embedded in the public page footer).
# AFILMORY_CORRESPONDING_SOURCE_URL=https://downloads.example.com/gallery/source.tar.gz
# AFILMORY_LICENSE_URL=https://github.com/your-name/your-gallery/blob/main/LICENSE
# AFILMORY_REQUIRE_EXACT_SOURCE=true

# ----------------------------------------
# Photo location privacy and build-time reverse geocoding
# ----------------------------------------
# coarse is the privacy-preserving default: public coordinates are rounded to
# three decimals (block scale, ~110 m) and altitude is kept. strip removes
# coordinates, altitude and place names. exact publishes camera GPS unchanged;
# use it only with informed consent.
PHOTO_LOCATION_MODE=coarse

# Reverse geocoding is opt-in because it sends the location selected above to an
# external provider. Set true only after reviewing that provider's privacy and
# usage policy. The default provider is the Nominatim public API. Follow its
# official policy:
# - no more than 1 request/second
# - a valid User-Agent is required
# - results must be cached
# - the site must display OpenStreetMap attribution

GEOCODING_ENABLED=false
GEOCODING_PROVIDER=nominatim
GEOCODING_LOCALES=en,zh-CN
# Legacy-config compatibility: GEOCODING_LANGUAGE is only read when GEOCODING_LOCALES is not set
GEOCODING_LANGUAGE=
GEOCODING_USER_AGENT="afilmory-vercel/0.1 (https://your-site.vercel.app)"
GEOCODING_CACHE_PATH=generated/geocoding-cache.json
GEOCODING_CACHE_PRECISION=4
GEOCODING_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Configure a Mapbox token when GEOCODING_PROVIDER=mapbox or auto
MAPBOX_TOKEN=

# Builder performance config (optional)
# If the current Node environment cannot clone plugin hooks into workers, set this
# to false to fall back to single-process concurrency.
BUILDER_USE_CLUSTER_MODE=true

# Number of builder workers (optional, positive integer; defaults to half the
# available CPUs rounded up, capped at 4).
# Lower it when local bandwidth is limited: with each worker downloading 2 files
# concurrently, the default can push large S3 downloads past their timeout.
# BUILDER_WORKER_COUNT=4

# Strict mode (optional, defaults to false). Set to true to exit with a non-zero
# code when any photo fails to process, instead of publishing the rest.
# BUILDER_FAIL_ON_PHOTO_ERROR=true

# Remote thumbnail cleanup (optional, defaults to dry-run). Set to true to
# actually delete orphaned thumbnails from remote storage; otherwise orphans are
# only reported.
# THUMBNAIL_STORAGE_CLEANUP=true

# ----------------------------------------
# Optional: remote repository cache
# ----------------------------------------
# Used for incremental CI/CD builds so that not every photo is reprocessed each time.
# scripts/build-static.sh restores the cache before the build and syncs the latest
# artifacts after a successful build. Use a private cache repository: exact mode
# may store precise coordinates. coarse/strip never transfer geocoding-cache.json
# and remove a legacy exact cache at the restore/save boundary.
# Ignore this if you are not using CI/CD.

REPO_URL=
REPO_TOKEN=
# The cache must use a separate repository. Grant REPO_TOKEN read/write access
# only to that repository; do not use an account-wide classic token.
# A dedicated branch is mandatory. The safe default is afilmory-cache; protected
# source branches such as main/master are always rejected.
# REPO_CACHE_BRANCH=afilmory-cache
# Optional destructive maintenance: compact the cache branch to one commit.
# This uses force-with-lease and is disabled unless explicitly opted in.
# REPO_CACHE_ALLOW_HISTORY_REWRITE=false

# Backward-compatible aliases:
# BUILDER_REPO_URL=
# GIT_TOKEN=
